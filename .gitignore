# ============================================================
# UCEK — Unstop Igniters Club Placement Platform
# Root .gitignore for Monorepo (Frontend + Backend)
# ============================================================

# ── PYTHON & BACKEND ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Databases
*.db
*.sqlite
*.sqlite3

# Python Testing & Coverage
.coverage
htmlcov/
.pytest_cache/


# ── NODE & FRONTEND DEPENDENCIES ────────────────────────────
node_modules/
frontend/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz


# ── BUILD OUTPUT ────────────────────────────────────────────
dist/
frontend/dist/
dist-ssr/
build/
out/
.vite/


# ── ENVIRONMENT & SECRETS ───────────────────────────────────
.env
frontend/.env
backend/.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.*
*.env
*.pem
*.key
*.cert
secrets/


# ── LOGS ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ── CACHE & TEMP FILES ──────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
.nx/cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
tsconfig.tsbuildinfo
.temp/
tmp/
temp/


# ── TESTING ─────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/


# ── AI AGENTS & TOOL CACHES ───────────────────────────────────
.codex/
.agents/
.impeccable/
.data/
plans/
animation-plans/


# ── EDITOR & IDE ────────────────────────────────────────────
# VS Code (keep extensions.json for team consistency)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains IDEs (WebStorm, IntelliJ, PyCharm)
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*.sw?
*~

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace


# ── OS GENERATED FILES ──────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Windows
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~


# ── TYPESCRIPT ──────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo


# ── VITE SPECIFIC ───────────────────────────────────────────
*.local
vite.config.ts.timestamp-*


# ── PACKAGE MANAGER LOCK FILES ──────────────────────────────
yarn.lock
pnpm-lock.yaml
bun.lockb
.pnpm-store/


# ── DEPLOYMENT ──────────────────────────────────────────────
.vercel/
.netlify/
.firebase/
.amplify/


# ── MISC ────────────────────────────────────────────────────
*.tgz
*.zip
*.tar.gz
.npmrc.local
.yarnrc.local
